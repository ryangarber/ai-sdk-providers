{
	"name": "@ryangarber/ai-sdk-providers",
	"version": "0.1.0",
	"description": "A collection of providers for AI SDK.",
	"files": [
		"dist"
	],
	"exports": {
		"./afm": {
			"types": "./dist/afm/index.d.mts",
			"default": "./dist/afm/index.mjs"
		},
		"./claude": {
			"types": "./dist/claude/index.d.mts",
			"default": "./dist/claude/index.mjs"
		},
		"./claude/local": {
			"types": "./dist/claude/local.d.mts",
			"default": "./dist/claude/local.mjs"
		},
		"./codex": {
			"types": "./dist/codex/index.d.mts",
			"default": "./dist/codex/index.mjs"
		},
		"./codex/local": {
			"types": "./dist/codex/local.d.mts",
			"default": "./dist/codex/local.mjs"
		},
		"./cursor": {
			"types": "./dist/cursor/index.d.mts",
			"default": "./dist/cursor/index.mjs"
		},
		"./cursor/local": {
			"types": "./dist/cursor/local.d.mts",
			"default": "./dist/cursor/local.mjs"
		}
	},
	"imports": {
		"#afm/*": "./src/afm/*",
		"#claude/*": "./src/claude/*",
		"#codex/*": "./src/codex/*",
		"#cursor/*": "./src/cursor/*",
		"#shared/*": "./src/shared/*"
	},
	"type": "module",
	"scripts": {
		"lint": "biome check --write",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsdown",
		"e2e:claude": "node scripts/claude-e2e.ts",
		"e2e:codex": "node scripts/codex-e2e.ts",
		"e2e:cursor": "node scripts/cursor-e2e.ts"
	},
	"author": "Ryan Garber",
	"license": "MIT",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24 <27",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.16.1",
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^26.6.6",
		"ai": "7.0.158",
		"knip": "^6.44.1",
		"koffi": "^3.3.6",
		"tsdown": "^0.23.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"@afmize/node": "^1.1.0",
		"@ai-sdk/provider": "^4.0.35",
		"@ai-sdk/provider-utils": "^5.0.72",
		"@anthropic-ai/claude-agent-sdk": "^0.3.316",
		"@cursor/sdk": "^1.3.1"
	},
	"peerDependencies": {
		"zod": "^4.1.8"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"ai-sdk",
		"provider",
		"apple",
		"apple-foundation-models",
		"afm",
		"siri",
		"siri-ai",
		"claude",
		"claude-code",
		"codex",
		"codex-cli",
		"cursor",
		"cursor-agent",
		"chatgpt",
		"gpt",
		"antigravity",
		"agy",
		"gemini"
	]
}
